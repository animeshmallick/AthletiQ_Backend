# ─── Runtime ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Comma-separated list of browser origins allowed to call the API (web app).
CORS_ORIGINS=http://localhost:5173
# Number of reverse-proxy hops in front of the app (e.g. 1 behind a single ALB/nginx).
TRUST_PROXY=0

# ─── Database (Neon) ──────────────────────────────────────────────────────
# Pooled connection string (host contains "-pooler") used by the app at runtime.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/athletiq?sslmode=verify-full
# Direct (unpooled) connection string used for migrations and the scheduler's advisory lock.
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/athletiq?sslmode=verify-full
DB_POOL_MAX=10

# ─── Auth ────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# true in production (HTTPS only). COOKIE_CROSS_SITE=true when web app and API are on different sites.
COOKIE_SECURE=false
COOKIE_CROSS_SITE=false
COOKIE_DOMAIN=

# ─── Public share links (invoice PDFs sent over WhatsApp) ─────────────────
SHARE_LINK_SECRET=change-me-to-another-long-random-string-32-chars
SHARE_LINK_TTL_DAYS=30
# Public base URL of this API, used to build share links (no trailing slash).
PUBLIC_API_URL=http://localhost:4000
# Public base URL of the web app (used in invite / password-reset links).
APP_URL=http://localhost:5173

# ─── Jobs ────────────────────────────────────────────────────────────────
# A Postgres advisory lock guarantees only one instance runs a job even if all instances enable it.
SCHEDULER_ENABLED=true
# Cron expression evaluated in Asia/Kolkata. Default: every day at 00:00 IST.
INVOICE_CRON=0 0 * * *
# Push notifications (Android app). Firebase console → Project settings → Service accounts →
# Generate new private key; paste the JSON base64-encoded on one line. Empty = push disabled.
FCM_SERVICE_ACCOUNT=
# Error reporting: Sentry → Project settings → Client Keys (DSN). Empty = off.
SENTRY_DSN=
# Optional; defaults to NODE_ENV.
SENTRY_ENVIRONMENT=
# Coaches get a "sessions today" push at this time (IST).
REMINDER_CRON=0 7 * * *

# ─── Seed (first admin, used by `npm run db:seed`) ────────────────────────
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_NAME=Academy Admin
SEED_ADMIN_PASSWORD=ChangeMe!12345
